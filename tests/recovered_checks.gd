extends SceneTree
const R = preload("res://rules.gd")
var game
var passed = 0
var failed = 0
func check(ok: bool, label: String):
	if ok: passed += 1; print("PASS ", label)
	else: failed += 1; push_error("FAIL " + label)
func reset():
	game.player_skill = "king"
	game.new_run()
	game.enemies = []
	game.add_enemy("g", Vector2i(4, 0), 9)
	game.deck = ["sword", "spear", "horse"]
	game.hand = []; game.hand_ids = []; game.discard = []
func _initialize(): call_deferred("run_checks")
func run_checks():
	game = load("res://main.tscn").instantiate(); root.add_child(game)
	check(game.screen == "home", "main scene opens home screen")
	game.new_run()
	check(game.lives == 5 and game.energy == 3 and game.hand.is_empty() and game.deck.size() == 4, "king initial resources")
	check(game.CARDS.size() == 36 and game.CAMPAIGN.LAST_STAGE == 6, "36 current cards including training grapple and decoy, and six debug stages")
	check(game.enemies[0].hp == 3, "general has three HP")
	reset(); game.basic_move(Vector2i(4,8))
	check(game.hand.size() == 1 and game.basic_used and game.energy == 3, "free move draws and costs no energy")
	game.basic_move(Vector2i(4,7))
	check(game.player == Vector2i(4,8) and game.hand.size() == 1, "second basic move rejected")
	game.hand = ["straight", "horse"]; game.hand_ids = []; game.play_card(0, Vector2i(4,6))
	check(game.player == Vector2i(4,6) and game.energy == 2 and game.card_move_used and game.hand.size() == 2, "paid movement charges its cost and draws")
	game.play_card(0, Vector2i(6,5))
	check(game.player == Vector2i(6,5) and game.energy == 1 and game.hand.size() == 2, "second paid movement succeeds, pays cost and draws once")
	var size_before = game.hand.size(); game.end_turn()
	check(game.energy == 3 and not game.basic_used and not game.card_move_used and game.hand.size() == size_before, "turn refresh retains hand without automatic draw")
	reset(); game.player = Vector2i(2,4); game.lives = 3; game.add_enemy("p",Vector2i(2,3),9)
	game.hand = ["suppress"]; game.play_card(0,game.player)
	check(game.enemies[1].cd == 11 and game.enemies[1].stun == 0 and game.hand.size() == 1, "suppression draws and adds two movement cooldown without stun")
	game.end_turn()
	check(game.lives == 2 and game.enemies[1].pos == Vector2i(2,3) and game.enemies[1].cd == 10, "attack ignores extended movement cooldown and attacker stays")
	check(not R.threatened(game.player, game.enemies) and R.occupied(game.player,game.enemies) == -1 and game.hand.size() == 1, "recoil reaches safe empty cell without extra draw")
	reset(); game.lives = 1; game.player = Vector2i(2,4); game.add_enemy("p",Vector2i(2,3),9); game.end_turn()
	check(game.phase == "dead", "one life hit ends run")
	reset(); game.player = Vector2i(4,1); game.hand = ["sword"]; game.play_card(0,Vector2i(4,0))
	check(game.enemies[0].hp == 2 and game.phase == "play", "single hit does not kill healthy general")
	game.hand = ["pierce"]; game.energy = 3; game.play_card(0,Vector2i(4,0))
	check(game.phase == "play" and game.enemies[0].hp == 2, "bleed queues damage rather than killing immediately")
	game.end_turn()
	check(game.phase == "play" and game.enemies[0].hp == 1 and game.pending_bleeds.size() == 1 and game.pending_bleeds[0].amount == 1, "current ending deals one bleed damage and preserves next ending")
	game.end_turn()
	check(game.phase == "reward" and game.rewards.size() == 3, "second ending bleed defeat opens three rewards")
	game.input_lock = 0; game.navigation_lock = 0; var collection_size = game.collection.size(); game.choose_reward(0)
	check(game.stage == 2 and game.collection.size() == collection_size + 1 and game.hand.is_empty(), "reward adds permanent card and starts next stage")
	reset(); game.hand = ["breath"]; game.play_card(0,game.player)
	check(game.energy == 4 and game.discard.is_empty(), "breath grants energy and exhausts")
	reset(); game.lives = 4; game.hand = ["life"]; game.play_card(0,game.player)
	check(game.lives == 5 and game.discard.is_empty(), "life heals and exhausts")
	reset(); game.deck = []; game.discard = ["sword"]; game.draw_card()
	check(game.hand == ["sword"] and game.discard.is_empty(), "empty deck recycles discard")
	reset(); game.hand = ["sword","sword","sword","sword","sword","sword"]; game.draw_card()
	check(game.phase == "discard" and game.hand.size() == 7, "seventh normal card requires discard")
	game.discard_hand(0); check(game.phase == "play" and game.hand.size() == 6, "discard resumes turn")
	reset(); game.hand = ["stake"]; game.play_card(0,Vector2i(4,7))
	check(game.enemies.back().kind == "stake" and game.enemies.back().ttl == 3, "stake created with three enemy phases")
	game.end_turn(); game.end_turn()
	check(game.enemies.back().kind == "stake" and game.enemies.back().ttl == 1, "stake survives first two phases")
	game.end_turn(); check(game.enemies.size() == 1, "stake expires in third enemy phase")
	reset(); game.player = Vector2i(2,4); game.add_enemy("e", Vector2i(2,3),9); game.enemies[1].hp = 1; game.hand = ["advance"]; game.play_card(0,Vector2i(2,3))
	check(game.player == Vector2i(2,3) and game.enemies.size() == 1 and not game.card_move_used and game.hand.is_empty() and game.active_displacements == 1, "advance enters defeated target cell without drawing or spending movement quota")
	reset(); game.stage = 3; game.start_stage(); var n = game.enemies.size(); game.end_turn(); game.end_turn(); game.end_turn()
	check(game.enemies.size() == n + 1 and game.enemies.back().kind == "h", "stage three spawns horse after three phases")
	reset(); game.stage = 6; game.player = Vector2i(4,1); game.enemies[0].hp = 1; game.hand = ["sword"]; game.play_card(0,Vector2i(4,0))
	check(game.phase == "win" and game.skill_system.horse_unlocked, "sixth stage victory unlocks horse")
	print("RESULT ",passed," passed, ",failed," failed")
	game.queue_free(); quit(1 if failed else 0)
