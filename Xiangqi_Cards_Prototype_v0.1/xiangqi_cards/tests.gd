extends SceneTree
const R=preload("res://rules.gd")
var count=0
func check(ok:bool,label:String):
 if not ok:push_error("FAIL "+label);quit(1)
 else:count+=1;print("PASS "+label)
func enemy(k:String,p:Vector2i,stun:int=0)->Dictionary:return {"kind":k,"pos":p,"stun":stun,"cd":5,"period":5}
func _initialize():
 var p=enemy("p",Vector2i(4,3))
 check(R.attacks(p,Vector2i(4,4),[p]),"pawn attack ignores cooldown")
 check(not R.attacks(p,Vector2i(5,3),[p]),"pawn before river cannot attack sideways")
 p.pos=Vector2i(4,5)
 check(R.attacks(p,Vector2i(5,5),[p]),"pawn across river attacks sideways")
 p.stun=1
 check(not R.attacks(p,Vector2i(4,6),[p]),"stun blocks attacks")
 var cannon=enemy("c",Vector2i(0,0))
 check(not R.attacks(cannon,Vector2i(0,3),[cannon]),"cannon cannot attack without screen")
 var screen=enemy("p",Vector2i(0,1))
 check(R.attacks(cannon,Vector2i(0,3),[cannon,screen]),"cannon attacks across exactly one screen")
 check(not R.attacks(cannon,Vector2i(0,4),[cannon,screen,enemy("p",Vector2i(0,2))]),"cannon blocked by two screens")
 var elephant=enemy("e",Vector2i(2,0))
 check(R.attacks(elephant,Vector2i(4,2),[elephant]),"elephant diagonal")
 check(not R.attacks(elephant,Vector2i(4,2),[elephant,enemy("p",Vector2i(3,1))]),"elephant eye blocked")
 var horse=enemy("h",Vector2i(4,4))
 check(not R.attacks(horse,Vector2i(6,5),[horse,enemy("p",Vector2i(5,4))]),"horse leg blocked")
 var recoil=R.safe_recoil(Vector2i(4,6),[p])
 check(recoil.size()>0,"recoil has safe candidates")
 for candidate in recoil:check(not R.threatened(candidate,[p]) and R.occupied(candidate,[p])<0,"recoil candidate safe and empty")
 var game=load("res://main.tscn").instantiate();root.add_child(game)
 game.new_run()
 check(game.hand.size()==0 and game.deck.size()==8,"stage starts empty hand and eight cards")
 game.hand=["stun"];game.player=Vector2i(2,4);game.enemies=[enemy("p",Vector2i(2,3)),enemy("g",Vector2i(4,0))]
 game.play_card(0,Vector2i(2,3))
 var before=game.enemies[0].pos
 game.end_turn()
 check(game.lives==3 and game.enemies[0].pos==before,"stun prevents next phase movement and attack")
 check(game.enemies[0].stun==0,"stun expires after one enemy phase")
 game.end_turn()
 check(game.lives==2,"attack occurs despite unexpired movement cooldown")
 game.new_run();game.hand=["sword"];game.player=Vector2i(4,1);game.play_card(0,Vector2i(4,0))
 check(game.phase=="reward","general defeat advances to reward")
 game.new_run();game.hand=["life"];game.lives=4;game.play_card(0,game.player)
 check(game.lives==5 and game.discard.is_empty(),"life gains one and exhausts")
 print("ALL ",count," TESTS PASSED")
 game.queue_free();quit()
